.DS_Store
.env

# Local agent/Claude settings. Keep shared entrypoints under .claude/ and
# .agents/ tracked; ignore only machine-specific configuration/state.
.claude/settings.local.json
.claude/**/settings.local.json
.claude/**/*.local.json
.claude/**/.cache/
.claude/**/cache/
.agents/settings.local.json
.agents/**/settings.local.json
.agents/**/*.local.json
.agents/**/.cache/
.agents/**/cache/

config/paths.json
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.mineru-cache/
config/zotero-cache/
.checkpoints/
raw/prepared/papers/assets/*
raw/tmp/
wiki/
