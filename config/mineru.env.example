# MinerU cloud API config used by the `api` backend in mineru_backend.py.
# Copy this file to ~/.config/MinerU/mineru.env (or
# $XDG_CONFIG_HOME/MinerU/mineru.env if set) and fill in your token.
# Real environment variables override anything set here.

# Required for --backend api. Get a token from https://mineru.net/apiManage/account/api
MINERU_API_TOKEN=

# Optional: override the API base URL (default https://mineru.net/api/v4)
# MINERU_API_BASE=https://mineru.net/api/v4

# Optional: model_version sent with the upload request: pipeline | vlm | MinerU-HTML
# MINERU_MODEL_VERSION=vlm
